      "id": "6f4cdd02-1abd-48e8-9da9-4e3a1573b1e7",
      "name": "Supabase: Status -> Content1",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2064, 3344]
    },
    {
      "parameters": {
        "jsCode": "// 1. جلب المعرفات من نود الـ Webhook بأمان\nconst webhookBody = $('Webhook Trigger').first().json.body || {};\nconst planId = webhookBody.planId || null;\nconst userId = webhookBody.userId || null;\n\n// 2. جلب النص الخام من مخرج Gemini\nlet raw = $('Gemini: 30-Day Calendar').first().json.text || '';\n\n// 3. تنظيف النص واستخراج الـ JSON بدقة\nif (typeof raw === 'string') {\n  raw = raw.trim();\n  const jsonMatch = raw.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    raw = jsonMatch[0];\n  }\n}\n\n// 4. التحقق والتحويل إلى Object\nlet parsed = {};\ntry {\n  parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (error) {\n  throw new Error(`فشل في تحويل استجابة Gemini إلى JSON: ${error.message}`);\n}\n\nconst items = Array.isArray(parsed.content_items) ? parsed.content_items : [];\n\n// 5. إرجاع العناصر مجهزة للإدخال في قاعدة البيانات\nreturn items.map((item, index) => ({\n  json: {\n    marketing_plan_id: planId,\n    user_id: userId,\n    day_number: item.day_number || (index + 1),\n    caption: item.caption || '',\n    design_copy: item.design_copy || {},\n    post_type: (item.post_type || 'static_post').toLowerCase().trim(),\n    content_objective: (item.content_objective || 'awareness').toLowerCase().trim(),\n    content_pillar: item.content_pillar || 'عام',\n    design_reference: item.design_reference || '',\n    cta: item.cta || (item.design_copy && item.design_copy.cta) || ''\n  }\n}));"
      },
