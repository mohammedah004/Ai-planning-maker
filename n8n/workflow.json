        "jsCode": "const items = $('Format Items for Insert1').all();\n\nreturn items.map(item => {\n  const row = item.json;\n  return {\n    json: {\n      \"Day\": row.day_number,\n      \"Post Type\": (row.post_type || '').toUpperCase(),\n      \"Objective\": row.content_objective,\n      \"Pillar\": row.content_pillar,\n      \"Headline\": row.design_copy?.headline || '',\n      \"Caption\": row.caption,\n      \"Design Reference\": row.design_reference,\n      \"Call To Action\": row.cta\n    }\n  };\n});"
