      "parameters": {
        "promptType": "define",
        "text": "=You are an expert Instagram content architect. Return ONLY a valid JSON object without markdown fences.\nBased on this strategy:\n{{ $('Gemini: Generate Strategy').item.json.text }}\n\nAnd marketing objective:{{ $('Webhook Trigger').item.json.body.plan.marketing_objective }}\n\nGenerate content pillars and objective distribution in strict JSON:\n{\n  \"content_pillars\": [\n    { \"name\": \"...\", \"description\": \"...\", \"percentage\": 25 }\n  ],\n  \"objective_distribution\": {\n    \"awareness\": 20,\n    \"education\": 20,\n    \"engagement\": 15,\n    \"trust\": 15,\n    \"social_proof\": 10,\n    \"objection_handling\": 10,\n    \"conversion\": 10\n  }\n}"
