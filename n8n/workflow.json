    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a master social media copywriter. Output ONLY valid strict JSON without markdown formatting fences.\nGenerate a 30-day Instagram calendar:\nProduct: {{ $('Webhook Trigger').item.json.body.plan.product_name }}\nBrand Tone: {{ $('Webhook Trigger').item.json.body.plan.brand_tone }}\nStrategy: {{ $('Gemini: Generate Strategy').item.json.text }}\nPillars: {{ $('Gemini: Generate Pillars').item.json.text }}\n\nReturn strict JSON with key \"content_items\" (30 items, days 1-30). Schema for each item:\n{\n  \"day_number\": 1,\n  \"caption\": \"...\",\n  \"design_copy\": {\"headline\": \"...\", \"subtext\": \"...\", \"cta\": \"...\"},\n  \"post_type\": \"reel\",\n  \"content_objective\": \"awareness\",\n  \"content_pillar\": \"...\",\n  \"design_reference\": \"Subject, Composition, Environment, Mood\",\n  \"cta\": \"...\"\n}\n(post_type: reel, carousel, static_post, story. content_objective: awareness, education, engagement, trust, social_proof, objection_handling, conversion)."
      },
